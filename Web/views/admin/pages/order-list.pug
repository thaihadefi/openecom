extends ../layouts/default.pug
include ../mixins/index.pug

block main
  .row
    .col-12
      .card
        .card-header
          .row.align-items-center
            .col
              h4.card-title #{pageTitle}
            .col-auto
              a.btn.btn-outline-danger.me-1(href=`/${pathAdmin}/order/trash`)
                i.fa-solid.fa-trash.me-1
                | Trash
              button.btn.btn-danger.me-1(
                button-soft-delete-many
                data-api=`/${pathAdmin}/api/orders/trash`
                style="display:none"
              )
                i.fa-solid.fa-trash.me-1
                | Move to Trash
        .card-body.pt-0
          .row
            .col-sm-6.mb-2
              +form-search()
            .col-lg-2.mb-2
              a.btn.w-100.btn-info(href=`/${pathAdmin}/api/orders/csv`)
                i.fa-solid.fa-download.me-1
                | Export Excel
          .table-responsive
            table.table.table-striped.mb-0
              thead.table-light
                tr
                  th(scope="col")
                    input.form-check-input.checkbox-all(type="checkbox" aria-label="Select all rows")
                  th(scope="col") No.
                  th(scope="col") Order Code
                  th(scope="col") Customer
                  th.text-nowrap(scope="col") Total
                  th(scope="col") Payment
                  th(scope="col") Payment Status
                  th(scope="col") Order Status
                  th.text-nowrap(scope="col") Date Created
                  th.text-end(scope="col") Action
              tbody
                if !recordList || !recordList.length
                  +empty-state()
                else
                  each item, index in recordList
                    tr
                      td
                        input.form-check-input.checkbox-input(type="checkbox" aria-label="Select this row" value=item.id)
                      td #{pagination.skip + index + 1}
                      td
                        b #{item.code}
                      td
                        div #{item.fullName}
                        small.text-muted #{item.phone}
                      td.text-nowrap
                        b.text-danger #{formatPrice((item.total || 0))}
                      td
                        span.badge(class=isOnlinePayment(item.paymentMethod) ? "bg-primary" : "bg-secondary") #{paymentMethodLabel(item.paymentMethod)}
                      td
                        case item.paymentStatus
                          when "unpaid"
                            span.badge.bg-warning Unpaid
                          when "paid"
                            span.badge.bg-success Paid
                          when "refunded"
                            span.badge.bg-info Refunded
                      td
                        case item.orderStatus
                          when "pending"
                            span.badge.bg-secondary Pending
                          when "confirmed"
                            span.badge.bg-primary Confirmed
                          when "shipping"
                            span.badge.bg-info Shipping
                          when "completed"
                            span.badge.bg-success Completed
                          when "cancelled"
                            span.badge.bg-danger Cancelled
                          when "returned"
                            span.badge.bg-dark Returned
                      td.text-nowrap
                        | #{formatDateTime(item.createdAt)}
                      td.text-end
                        a.tbl-action(
                          href=`/${pathAdmin}/order/edit/${item.id}`
                          title="Edit order"
                          aria-label="Edit order"
                        )
                          i.las.la-pen.text-secondary.fs-20
                        a.tbl-action.danger(
                          href="javascript:;"
                          button-api
                          data-method="DELETE"
                          data-api=`/${pathAdmin}/api/orders/${item.id}`
                          title="Move to trash"
                          aria-label="Move to trash"
                          data-confirm="trash"
                        )
                          i.las.la-trash-alt.text-secondary.fs-20
          +pagination()
