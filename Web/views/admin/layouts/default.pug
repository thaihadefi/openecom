doctype html
html(
  data-bs-theme="light"
  data-startbar="light"
  dir="ltr"
  lang="en"
  )
  head
    script.
      const pathAdmin = "#{pathAdmin}";
      const domainCDN = "#{domainCDN}";
      window.storeLocale = !{safeJson({ currency: storefront.currency, displayCurrencies: storefront.displayCurrencies, locale: storefront.locale, timezone: storefront.timezone, digits: currencyDigits })};
      window.storeLocation = !{safeJson(storeContact ? storeContact.coordinates : null)};
    meta(charset="utf-8")
    title #{pageTitle}
    meta(
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
      name="viewport"
      )
    meta(
      name="description"
      content=`${(settingGeneral && settingGeneral.websiteName) || "Store"} administration`
      )
    meta(
      name="author"
      content=(settingGeneral && settingGeneral.websiteName) || "Store"
      )
    meta(
      content="IE=edge"
      http-equiv="X-UA-Compatible"
      )
    link(
      href=`${settingGeneral && settingGeneral.favicon ? domainCDN + settingGeneral.favicon : '/images/favicon.svg'}`
      rel="shortcut icon"
      )
    link(rel="stylesheet", href="/admin/assets/libs/notyf/notyf.min.css" integrity="sha384-snpJ3knpH6avB6cP1vPkNdmRzCYaCpom/3TNOyvo189BiogXYXQfXkyYpZ2/xADs" crossorigin="anonymous")
    link(href="/admin/assets/libs/uppy/uppy.min.css" rel="stylesheet")
    link(rel="stylesheet", href="/admin/assets/libs/selectr/selectr.min.css" integrity="sha384-O1PAcYRxlWavYIL+m80+1ZJEeTsz7WNgQ2OuONoGg4dgLExWaGMPQXVs5hlSbNIE" crossorigin="anonymous")
    link(href="/admin/assets/libs/jsoneditor/jsoneditor.min.css" integrity="sha384-cj1rYBc4/dVYAknZMTkVCDRL6Knzugf32igVqsuFW0iRWFHKH8Ci8+ekC8gNsFZ+" crossorigin="anonymous" rel="stylesheet")
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/libs/vanillajs-datepicker/css/datepicker.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/bootstrap.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href="/admin/assets/css/icons.min.css"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href=`/admin/assets/css/app.min.css?v=${assetVersion || 0}`
      )
    link(
      rel="stylesheet"
      href="/admin/assets/libs/font-awesome/css/all.min.css" integrity="sha384-nRgPTkuX86pH8yjPJUAFuASXQSSl2/bBUiNV47vSYpKFxHJhbcrGnmlYpYJMeD7a" crossorigin="anonymous"
      )
    link(
      type="text/css"
      rel="stylesheet"
      href=`/admin/assets/css/main.css?v=${assetVersion || 0}`
      )
  body
    script.
      document.body.setAttribute("data-sidebar-size", innerWidth >= 310 && innerWidth <= 1440 ? "collapsed" : "default");
    include ../partials/topbar.pug
    include ../partials/startbar.pug
    .page-wrapper
      main.page-content(role="main" id="main-content")
        .container-xxl
          block main
        include ../partials/footer.pug

    include ../partials/modal-file-manager.pug
    include ../partials/modal-confirm.pug

    script(src="/admin/assets/libs/just-validate/just-validate.production.min.js" integrity="sha384-MTEqTcTyVLHVQNcumujWT8ThfE2tAm0jR8FP+YSLHn3KRydBdxTYaiK9USgsaU5e" crossorigin="anonymous")
    script(src="/admin/assets/libs/notyf/notyf.min.js" integrity="sha384-uuNfwJfjOG2ukYi4eAB11/t3lP4Zjf75a3UhgkLzEpiX8JpJfacpG7Ye+0tiVMxT" crossorigin="anonymous")
    script(src="/admin/assets/libs/tinymce/tinymce.min.js")
    script(src="/admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/admin/assets/libs/simplebar/simplebar.min.js")
    script(src="/admin/assets/libs/sortablejs/Sortable.min.js" integrity="sha384-HZZ/fukV+9G8gwTNjN7zQDG0Sp7MsZy5DDN6VfY3Be7V9dvQpEpR2jF2HlyFUUjU" crossorigin="anonymous")
    script(src="/admin/assets/libs/selectr/selectr.min.js" integrity="sha384-kpRfuhIjTUhRJPetumAT2UykEKnqXdurw75vUs2015lqpEhsRfkoOF/gMcrWr02F" crossorigin="anonymous")
    script(src="/admin/assets/libs/jsoneditor/jsoneditor.min.js" integrity="sha384-Om1Bp2exFp3Ll1dmNKTYPF4wSgGsZu1bXp+oe9yLEg58FKqabAAfDsNoW+qxuH1+" crossorigin="anonymous")
    block script
    script(src="/admin/assets/libs/vanillajs-datepicker/js/datepicker-full.min.js")
    script(src=`/admin/assets/js/app.js?v=${assetVersion || 0}`)
    script(src=`/common/assets/js/location-picker.js?v=${assetVersion || 0}`)
    script(src=`/admin/assets/js/main.js?v=${assetVersion || 0}`)
    script(src=`/admin/assets/js/uppy.js?v=${assetVersion || 0}` type="module")
    if (FEATURES.CHAT)
      script(src="/socket.io/socket.io.js")
      script(src=`/admin/assets/js/chat.js?v=${assetVersion || 0}`)
