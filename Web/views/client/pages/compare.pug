extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner(
    {
      name: pageTitle
    },
    `/compare`
  )

  section(class="compare_page mt_60 mb_100")
    .container
      .compare_header_bar.mb-4.text-center
        h2.compare_title Product Comparison
        p.compare_sub Compare features, prices, and specifications side by side to choose the best product!
      .row
        .col-12
          .wow.fadeInUp(class="compare_list_area compare_card_wrapper")
            .table-responsive
              table.table.compare_table
                tbody
                  tr
                    td.compare_label_col
                      p
                        b Product
                    td(html-1)
                  tr
                    td.compare_label_col
                      p
                        b Description
                    td(html-2)
                  tr
                    td.compare_label_col
                      p
                        b Price
                    td(html-3)
                  tr
                    td.compare_label_col
                      p
                        b Variants
                    td(html-4)
                  tr
                    td.compare_label_col
                      p
                        b Rating
                    td(html-5)
                  tr
                    td.compare_label_col
                      p
                        b Action
                    td(html-6)
