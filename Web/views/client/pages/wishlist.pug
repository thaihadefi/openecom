extends ../layouts/default.pug
include ../mixins/index.pug

block main
  +page-banner(
    {
      name: pageTitle
    },
    `/wishlist`
  )

  section(class="wishlist_page cart_page mt_60 mb_100")
    .container
      .wishlist_header_bar.mb-4.text-center
        h2.wishlist_title My Wishlist
        p.wishlist_sub All your saved favorites in one place — ready to add to your cart anytime!
      .row.justify-content-center
        .col-xxl-10.col-xl-11
          .wow.fadeInUp(class="cart_table_area wishlist_card_wrapper")
            .table-responsive
              table.table.wishlist_table
                thead
                  tr
                    th(class="cart_page_img") Product
                    th(class="cart_page_details") Details
                    th(class="cart_page_price") Price
                    th(class="cart_page_quantity") Quantity
                    th(class="cart_page_price") Subtotal
                    th(class="cart_page_action") Action
                tbody(wishlist-table)
