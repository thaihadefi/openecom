    script(type="speculationrules").
      {
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/#{pathAdmin}/*" } },
                { "not": { "href_matches": "/auth/*" } },
                { "not": { "href_matches": "/checkout/*" } },
                { "not": { "href_matches": "/order/*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    script.
      (function() {
        if (!('fetch' in window)) return;
        const prefetched = new Set();
        const prefetch = function(url) {
          if (!url || prefetched.has(url)) return;
          prefetched.add(url);
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = url;
          document.head.appendChild(link);
        };
        document.addEventListener('mouseover', function(e) {
          const a = e.target.closest('a');
          if (!a || !a.href || a.origin !== location.origin || a.target === '_blank') return;
          const p = a.pathname;
          if (p.startsWith('/#{pathAdmin}') || p.startsWith('/auth') || p.startsWith('/checkout') || p.startsWith('/order')) return;
          prefetch(p + a.search);
        }, { passive: true });
        document.addEventListener('touchstart', function(e) {
          const a = e.target.closest('a');
          if (!a || !a.href || a.origin !== location.origin || a.target === '_blank') return;
          const p = a.pathname;
          if (p.startsWith('/#{pathAdmin}') || p.startsWith('/auth') || p.startsWith('/checkout') || p.startsWith('/order')) return;
          prefetch(p + a.search);
        }, { passive: true });
      })();
    //- PWA Service Worker registration
    script.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js?admin=#{encodeURIComponent(pathAdmin)}').catch(function() {});
        });
      }
