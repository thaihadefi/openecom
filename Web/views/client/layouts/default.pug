doctype html
html(lang=storefront.language)
  head
    script.
      (function() {
        const savedLang = localStorage.getItem("selectedLanguage") || "en";
        if (savedLang && savedLang !== "en") {
          document.documentElement.classList.add("translation-pending");
          setTimeout(function() {
            document.documentElement.classList.remove("translation-pending");
          }, 500);
          const observer = new MutationObserver(function(mutations) {
            if (document.documentElement.classList.contains("translated-ltr") ||
                document.documentElement.classList.contains("translated-rtl")) {
              document.documentElement.classList.remove("translation-pending");
              observer.disconnect();
            }
          });
          observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        }
      })();
    style.
      html.translation-pending body {
        opacity: 0.7;
        transition: opacity 0.2s ease;
      }
    script.
      const domainCDN = "#{domainCDN}";
      window.storeLocale = !{safeJson({ currency: storefront.currency, displayCurrencies: storefront.displayCurrencies, locale: storefront.locale, timezone: storefront.timezone, digits: currencyDigits })};
      window.storeLocation = !{safeJson(storeContact ? storeContact.coordinates : null)};
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0"
      name="viewport"
      )

    //- Head metadata: a page's saved SEO (admin) wins, then what the controller passes
    //- (pageDescription, pageImage, ogType, jsonLd, markdownPath), then Settings > General.
    -
      const brandName = (settingGeneral && settingGeneral.websiteName) ? settingGeneral.websiteName : "OpenEcom"
      const seoData = seo || {}
      const seoOg = seoData.og || {}
      const seoRobots = seoData.robots || {}
      const metaTitle = seoData.title || (fullTitle || pageTitle === brandName ? pageTitle : `${pageTitle} | ${brandName}`)
      const metaDescription = seoData.description || pageDescription || (settingGeneral && settingGeneral.storeDescription) || ""
      const metaIndex = !noindex && seoRobots.index !== false
      const metaFollow = seoRobots.follow !== false
      const metaImagePath = seoOg.image || pageImage || (settingGeneral && settingGeneral.logo) || ""
      const metaImage = metaImagePath && typeof absoluteUrl === "function" ? absoluteUrl(siteOrigin, metaImagePath) : ""
    title= metaTitle
    meta(name="description" content=metaDescription)
    meta(name="robots" content=`${metaIndex ? "index" : "noindex"}, ${metaFollow ? "follow" : "nofollow"}`)

    //- Republished content points search engines at the original (canonicalSource); everything else at itself.
    link(rel="canonical" href=(canonicalSource || canonicalUrl))
    if (markdownPath)
      link(rel="alternate" type="text/markdown" href=markdownPath title="Markdown version")

    meta(property="og:site_name" content=brandName)
    meta(property="og:type" content=(ogType || "website"))
    meta(property="og:url" content=canonicalUrl)
    meta(property="og:title" content=(seoOg.title || metaTitle))
    meta(property="og:description" content=(seoOg.description || metaDescription))
    if (metaImage)
      meta(property="og:image" content=metaImage)
      meta(property="og:image:alt" content=(seoOg.title || pageTitle))
    meta(name="twitter:card" content=(metaImage ? "summary_large_image" : "summary"))

    each ld in [].concat(siteJsonLd || [], jsonLd || [])
      script(type="application/ld+json")!= safeJson(ld)

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
