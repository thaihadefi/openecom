    - const themeFonts = [storefront.headingFont, storefront.bodyFont].filter(Boolean)
    if (themeFonts.length)
      link(rel="stylesheet" href=`https://fonts.googleapis.com/css2?${[...new Set(themeFonts)].map(f => "family=" + encodeURIComponent(f).replace(/%20/g, "+") + ":wght@400;500;600;700").join("&")}&display=swap`)
    style.
      :root {
        --themeColorOne: #{safeColor(storefront.primaryColor)};
        --themeColorTwo: #{safeColor(storefront.secondaryColor)};
      #{typeof readableTextOn === "function" ? `--onThemeColorOne: ${readableTextOn(storefront.primaryColor)}; --onThemeColorTwo: ${readableTextOn(storefront.secondaryColor)};` : ""}
      #{storefront.primaryColor.toLowerCase() !== STOREFRONT_DEFAULTS.primaryColor.toLowerCase() ? "--lightBg: color-mix(in srgb, var(--themeColorOne) 7%, #fff);" : ""}
      #{storefront.headingFont ? `--headingFont: "${storefront.headingFont}", sans-serif;` : ""}
