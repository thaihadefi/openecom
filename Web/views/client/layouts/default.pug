  body(class="default_home")
    a.skip-to-main(href="#main-content") Skip to main content
    div#sr-live-region(aria-live="polite" aria-atomic="true" class="sr-only-live")
    include ../partials/header.pug
    include ../partials/main-menu.pug
    include ../partials/mini-cart.pug
    include ../partials/mobile-menu-area.pug

    main#main-content
      block main

    include ../partials/footer.pug

    if (FEATURES.CHAT)
      include ../partials/chat.pug

    include ../partials/scroll-button.pug

    include ../partials/modal-confirm.pug

    #modalReportReview.modal.fade(tabindex="-1" aria-labelledby="modalReportReviewLabel" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-sm
        .modal-content.confirm_modal
          .modal-body
            span.confirm_modal_icon
              i.fas.fa-flag(aria-hidden="true")
            h2#modalReportReviewLabel.confirm_modal_title Report this review?
            p.confirm_modal_text This will flag the review for admin to inspect. Only report content that is fake or inappropriate.
          .modal-footer
            button.confirm_modal_cancel(type="button" data-bs-dismiss="modal") Cancel
            button#btnConfirmReport.confirm_modal_ok(type="button") Report

    #modalPhoneConfirm.modal.fade(tabindex="-1" aria-labelledby="modalPhoneConfirmLabel" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-sm
        .modal-content.confirm_modal
          .modal-body
            span.confirm_modal_icon
              i.fas.fa-phone-alt(aria-hidden="true")
            h2#modalPhoneConfirmLabel.confirm_modal_title Contact Hotline
            p#modalPhoneConfirmMessage.confirm_modal_text Would you like to call us?
          .modal-footer
            button.confirm_modal_cancel(type="button" data-bs-dismiss="modal") Cancel
            a#modalPhoneConfirmCall.confirm_modal_ok(href="") Call Now

