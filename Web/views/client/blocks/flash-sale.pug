include ../mixins/index.pug

- const saleEnd = blockData && blockData.endTime ? new Date(blockData.endTime) : null
- const msLeft = saleEnd && !isNaN(saleEnd) ? saleEnd.getTime() - Date.now() : null
- const activeEndTime = (saleEnd && !isNaN(saleEnd) && msLeft > 0) ? blockData.endTime : new Date(Date.now() + 3 * 24 * 3600 * 1000 + 12 * 3600 * 1000).toISOString()
if blockData && blockProductList && blockProductList.length
  section(class="flash_sell flash_sell mt_95")
    .container
      .row.align-items-center
        .col-xxl-5.col-md-3.col-xl-4
          div(class="section_heading section_heading")
            h2
              span #{blockData.title.highlight}
              |  #{blockData.title.normal}
        .col-xxl-7.col-md-9.col-xl-8
          .d-flex.flex-wrap.align-items-center.justify-content-md-end.gap-3
            .flash_sale_timer_wrap
              span.flash_timer_label
                i.fas.fa-bolt.me-1(aria-hidden="true" style="color: #f59e0b;")
                | Hurry up! Sale ends in:
              .simply-countdown.simply-countdown-one(data-end-time=activeEndTime)
            if (blockData.linkViewAll)
              div(class="view_all_btn_area")
                a(
                  href=safeUrl(blockData.linkViewAll)
                  class="view_all_btn"
                  ) #{blockData.viewAll}
      .row(class="mt_25 flash_sell_slider")
        each item in blockProductList
          .col-12.wow.fadeInUp
            +product-item(item)
