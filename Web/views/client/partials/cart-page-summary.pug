mixin coupon-entry()
  .coupon-entry
    label.visually-hidden(for="couponCode") Coupon Code
    input.inner-input(placeholder="Coupon Code" type="text" name="coupon" id="couponCode" autocomplete="off")
    button.common_btn.inner-button(type="submit") Apply

div(class="cart_page_summary")
  h2 Order Summary
  ul(cart-summary)
  p.summary_row
    | Subtotal
    span
      span(sub-total) 0
  div(class="checkout_shipping")
    p.summary_row.summary_row_head Shipping Method
    div(shipping-list)
  p.summary_row
    | Discount
    span
      span(discount) 0
  if (FEATURES.LOYALTY_POINTS)
    p.summary_row(class="checkout_point_row" hidden point-row)
      label(style="display: flex; align-items: center; gap: 6px; cursor: pointer;")
        input(type="checkbox" id="usePointCheckbox" use-point-checkbox)
        | Use Points
        span(style="font-weight: normal; font-size: 13px;" available-point)
      span
        span(point-discount) 0
  p.summary_total
    | Total
    span
      span(total) 0
  p.small.text-muted.mt-2(data-charge-currency-note hidden)
    | Prices in other currencies are estimates. You will be charged in #{storefront.currency}.
  if (FEATURES.COUPONS)
    form(id="applyCouponForm")
      if !(typeof collapseCouponEntry !== 'undefined' && collapseCouponEntry)
        +coupon-entry()
      p(class="inner-view-coupon" style="display: none;")
        span
          | Coupon:
          b(class="inner-coupon")
        a(href="javascript:;" class="inner-remove" aria-label="Remove coupon")
          i.fas.fa-times(aria-hidden="true")
      if (typeof collapseCouponEntry !== 'undefined' && collapseCouponEntry)
        details.coupon-editor
          summary Add or change coupon
          +coupon-entry()
