header(class="header_main")
  .container
    .row.align-items-center
      .col-lg-2.col-xl-2.col-xxl-2
        div(class="header_logo_area")
          a(
            class="header_logo"
            href="/"
            )
            img.img-fluid.w-100.notranslate(
              alt=(settingGeneral && settingGeneral.websiteName) || "Home"
              src=`${settingGeneral && settingGeneral.logo ? domainCDN + settingGeneral.logo : '/images/logo.png'}`
              translate="no"
              )
            if (storefront && storefront.logoDisplay === "logo-name" && settingGeneral && settingGeneral.websiteName)
              span.header_logo_name.notranslate(translate="no" aria-hidden="true")= settingGeneral.websiteName
          //- Phones and tablets keep search and the cart one tap away; the rest of the menu lives in the off-canvas.
          .header_mobile_actions.d-flex.d-lg-none
            button.header_mobile_btn(
              aria-controls="offcanvasWithBothOptions"
              aria-label="Search products"
              data-bs-target="#offcanvasWithBothOptions"
              data-bs-toggle="offcanvas"
              data-mobile-search
              type="button"
              )
              i.fas.fa-search(aria-hidden="true")
            a.header_mobile_btn(href="/cart" aria-label="Shopping cart")
              i.fas.fa-shopping-cart(aria-hidden="true")
              span.header_mobile_count(mini-cart-quantity aria-hidden="true") 0
            button.header_mobile_btn.theme_toggle_btn(
              type="button"
              aria-label="Toggle dark mode"
              title="Toggle Dark/Light Mode"
              )
              i.fas.fa-moon(aria-hidden="true")
            button.d-block.d-lg-none(
              aria-controls="offcanvasWithBothOptions"
              aria-label="Open menu"
              data-bs-target="#offcanvasWithBothOptions"
              data-bs-toggle="offcanvas"
              class="mobile_menu_icon"
              type="button"
              )
              span(class="mobile_menu_icon")
                i.fas.fa-bars(class="menu_icon_bar" aria-hidden="true")
      .col-lg-5.col-xl-5.col-xxl-5.d-none.d-lg-block
        form(form-search action="/search" method="get" role="search")
          .input
            button(class="inner-voice" button-voice type="button" aria-label="Search by voice")
              <i class="fas fa-microphone" aria-hidden="true"></i>
            input(
              placeholder="Search products..."
              type="search"
              name="keyword"
              maxlength="100"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
              aria-label="Search products"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="search-suggest-list"
              )
            button(type="submit" aria-label="Search")
              i.fas.fa-search(aria-hidden="true")
          .inner-suggest(style="display: none;")
            .inner-title(search-suggest-title) Suggested Products
            .inner-list#search-suggest-list(role="listbox" aria-label="Search suggestions")
      .col-lg-5.col-xl-5.col-xxl-5.d-none.d-lg-flex.align-items-center.justify-content-end.gap-3.gap-xl-4
        .header_support_user
          if storeContact.phone
            div(class="header_support")
              a.icon(href=storeContact.phoneHref aria-label="Call Hotline")
                i.fas.fa-phone-alt(aria-hidden="true")
              .header_hotline
                span.header_hotline_label Hotline:
                a(href=storeContact.phoneHref)
                  span= storeContact.phone
        .d-flex.align-items-center.topbar_right
          button.theme_toggle_btn(type="button" aria-label="Toggle dark mode" title="Toggle Dark/Light Mode")
            i.fas.fa-moon(aria-hidden="true")
          if (FEATURES.TRANSLATE)
            .gtranslate_wrapper
          if (storefront.displayCurrencies.length > 1)
            select(class="select_js notranslate" translate="no" aria-label="Select currency" data-currency-switcher)
              each code in storefront.displayCurrencies
                option(value=code) #{code}
