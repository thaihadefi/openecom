{
  "name": "openecom-file-manager",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register index.ts",
    "debug": "node --watch --inspect=9230 -r ts-node/register index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint:any": "bash -c '! grep -rn --include=\"*.ts\" --exclude-dir={node_modules,dist} \": any\\b\" .'"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
